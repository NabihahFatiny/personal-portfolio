# Copy this file to .env and fill in your values.
# Contact form can use EITHER Formspree (easy) OR the Node server (Gmail).

# --- Option A: Formspree (no server needed, no Gmail setup) ---
# 1. Go to https://formspree.io and sign up
# 2. Create a new form, set email to nurnabihahfatiny545@gmail.com
# 3. Copy your form ID (e.g. xyzabc from https://formspree.io/f/xyzabc)
# 4. Set it here and restart the React app (npm start). You do NOT need to run node server.js.
REACT_APP_FORMSPREE_ID=

# --- Option B: Node server with Gmail (run npm run dev) ---
# Only needed if you are NOT using Formspree.
# Get a Gmail App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=nurnabihahfatiny545@gmail.com
EMAIL_PASS=
